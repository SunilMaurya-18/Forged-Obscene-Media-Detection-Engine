# Copy to .env and fill every REQUIRED value before `docker compose up`.
# Generate secrets with: openssl rand -hex 32
# Full production checklist: .env.production.example and docs/DEPLOY.md
#
# Compose defaults APP_PROFILE=prod. The backend and ML service refuse published/weak
# secrets outside the test profile.

# --- Required -------------------------------------------------------------------------------
POSTGRES_PASSWORD=
MODERATOR_USERNAME=
MODERATOR_PASSWORD=
# Owner console: ADMIN opens /admin to manage staff and solo-operate four-eyes when needed.
MODERATOR_ROLE=ADMIN
# 32+ characters. Signs provenance manifests embedded in labelled files.
PROVENANCE_SIGNING_KEY=
# 32+ characters. Partner account IDs are stored only as HMAC(key, account).
INVESTIGATION_PSEUDONYM_KEY=

# --- Optional accounts ----------------------------------------------------------------------
# Extra staff, comma-separated "username:password:ROLE:team".
# ROLE: MODERATOR | SENIOR_MODERATOR | ADMIN | INVESTIGATOR
# MODERATOR_EXTRA_ACCOUNTS=

# --- Stack wiring ---------------------------------------------------------------------------
ML_SERVICE_URL=http://ml-service:8000
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/forged_media
# Host ports: frontend :3000, backend :8081. Overlay docker-compose.dev.yml to expose DB/Redis.
NSFW_BACKEND=heuristic

# --- Detection thresholds -------------------------------------------------------------------
DECISION_FORGERY_AUTO_FLAG=0.85
DECISION_EXPLICIT_AUTO_FLAG=0.85
DECISION_FORGERY_REVIEW=0.50
DECISION_EXPLICIT_REVIEW=0.50

# --- Compliance / SLA -----------------------------------------------------------------------
COMPLIANCE_SLA_USER_COMPLAINT=PT2H
COMPLIANCE_SLA_GOVERNMENT_ORDER=PT3H
COMPLIANCE_SLA_AT_RISK=PT30M
COMPLIANCE_SLA_CHECK_INTERVAL=PT15S
COMPLIANCE_ESCALATION_WEBHOOK_URL=
COMPLIANCE_DEFAULT_JURISDICTION=IN
COMPLIANCE_GENERIC_USER_COMPLAINT_HOURS=24
COMPLIANCE_GENERIC_GOVERNMENT_ORDER_HOURS=24
COMPLIANCE_GENERIC_APPEAL_HOURS=72
REPORT_LOCAL_ZONE=Asia/Kolkata

# --- Provenance -----------------------------------------------------------------------------
PROVENANCE_ISSUER=forged-media-detection

# --- Partner API ----------------------------------------------------------------------------
API_RATE_LIMIT_FREE=10
API_RATE_LIMIT_PRO=60
API_RATE_LIMIT_ENTERPRISE=600
# Leave empty. Issue keys from /api-access (shown once, stored as SHA-256 only).
# API_BOOTSTRAP_KEY=

# --- Prescreen (hashes only) ----------------------------------------------------------------
PRESCREEN_PHASH_MAX_DISTANCE=8
PRESCREEN_PDQ_MAX_DISTANCE=31
# Optional INTERNAL_CONFIRMED seeds (hex pHashes). Empty = none.
PRESCREEN_SEED_HASHES=

# --- Handover / complaints ------------------------------------------------------------------
HANDOVER_DOWNLOAD_WINDOW=PT24H
HANDOVER_MAX_REQUEST_TERM=P180D
COMPLAINTS_MAX_PIN_ATTEMPTS=5
COMPLAINTS_PIN_LOCKOUT=PT15M
COMPLAINTS_NOTIFY_WEBHOOK_URL=

# --- Report signing -------------------------------------------------------------------------
REPORT_SIGNING_PROVIDER=file
REPORT_SIGNING_ALLOW_FILE_KEYS=true
# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_TRANSIT_KEY=fmd-report-signing
# REPORT_TSA_URL=
# REPORT_TSA_TRUSTED_CERTS=

# --- Observability / scale ------------------------------------------------------------------
# APP_PROFILE=prod
# STATE_STORE=redis
# REDIS_PASSWORD=
# ML_SERVICE_TIMEOUT=PT60S
# ML_WORKERS=1
# ML_DEVICE=auto
# VIDEO_BATCH_SIZE=8
# BACKEND_LOG_FORMAT=ecs
# ML_LOG_FORMAT=json

# --- Legal pages (frontend build-time) ------------------------------------------------------
# Rebuild the frontend image after changing. Have both documents reviewed by counsel.
VITE_LEGAL_OPERATOR=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_GRIEVANCE_OFFICER=
VITE_LEGAL_GOVERNING_LAW=
# VITE_LEGAL_EFFECTIVE_DATE=
