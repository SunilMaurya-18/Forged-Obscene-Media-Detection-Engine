# Copy to .env and adjust as needed

ML_SERVICE_URL=http://ml-service:8000
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/forged_media
POSTGRES_PASSWORD=forged

# Host ports (docker-compose): frontend :3000, mock feed :3001, backend :8081
# ml-service :8000 and postgres :5432 are internal unless docker-compose.dev.yml is layered on
# NSFW_BACKEND=heuristic|transformers|auto  (default heuristic for fast offline cold-start)
NSFW_BACKEND=heuristic

# Phase 8 — seeded moderator (dev only)
MODERATOR_USERNAME=moderator
MODERATOR_PASSWORD=moderator

# Lower review band so synthetic demo samples hit REVIEW (Phase 10)
DECISION_FORGERY_REVIEW=0.05

# Phase 13 — IT Rules 2026 takedown SLAs (ISO-8601 durations).
# Shorten these (e.g. PT4M / PT6M / PT2M) to watch ON_TRACK -> AT_RISK -> BREACHED live during a demo.
COMPLIANCE_SLA_USER_COMPLAINT=PT2H
COMPLIANCE_SLA_GOVERNMENT_ORDER=PT3H
COMPLIANCE_SLA_AT_RISK=PT30M
COMPLIANCE_SLA_CHECK_INTERVAL=PT15S
# Optional: POST JSON here on every AT_RISK / BREACHED escalation (blank = log only)
COMPLIANCE_ESCALATION_WEBHOOK_URL=
# Seed one sample complaint per SLA stage on an empty database (dev/demo only)
COMPLIANCE_SEED_DEMO=true

# Phase 14 — provenance manifests. The HMAC key signs every embedded manifest; changing it
# makes previously labelled files fail verification. Use a long random secret outside dev.
PROVENANCE_SIGNING_KEY=dev-only-provenance-signing-key
PROVENANCE_ISSUER=forged-media-detection

# Phase 15 — evidentiary reports print every timestamp in UTC plus this local zone (IANA ID).
REPORT_LOCAL_ZONE=Asia/Kolkata

# Phase 16 — third-party API (/api/v1). Requests per minute per key for each plan.
API_RATE_LIMIT_FREE=10
API_RATE_LIMIT_PRO=60
API_RATE_LIMIT_ENTERPRISE=600
# Dev/demo only: seeds a FREE-plan "Demo Platform" client with this key. Leave empty in production
# and issue real keys from the API access page (they are shown once and stored only as SHA-256).
API_DEMO_KEY=fmd_live_demo_local_only_do_not_use_in_prod

# Phase 18 — "Check before you post" prescreen. Only hashes are ever sent or stored.
# Hamming distance (bits) at or below which a hash counts as a match (pHash is 64-bit, PDQ 256-bit).
PRESCREEN_PHASH_MAX_DISTANCE=8
PRESCREEN_PDQ_MAX_DISTANCE=31
# Seeded INTERNAL_CONFIRMED hashes (default: frontend/public/prescreen-demo.png, a synthetic pattern).
PRESCREEN_SEED_HASHES=c2423d3d3b783cc6

# Phase 26 — partner-reported account IDs are stored only as HMAC-SHA256(key, platform + account).
# Outside the dev profile set 32+ random characters (e.g. `openssl rand -hex 32`); changing it later
# unlinks every existing pseudonym.
INVESTIGATION_PSEUDONYM_KEY=dev-only-account-pseudonym-key-change-me

# Phase 28 — investigators are accounts with role INVESTIGATOR in MODERATOR_EXTRA_ACCOUNTS (the dev
# default adds investigator/investigator). Packages can be downloaded for this long after they are
# issued, and a legal request can run at most this long.
HANDOVER_DOWNLOAD_WINDOW=PT24H
HANDOVER_MAX_REQUEST_TERM=P180D

# Phase 19 — jurisdiction used when a request doesn't pass one (no geo-IP inference), and the
# deadlines seeded for the GENERIC fallback rule. IN/US rules live in the jurisdiction_rules table.
COMPLIANCE_DEFAULT_JURISDICTION=IN
COMPLIANCE_GENERIC_USER_COMPLAINT_HOURS=24
COMPLIANCE_GENERIC_GOVERNMENT_ORDER_HOURS=24

# Phase 20 — report signing. docker-compose keeps the dev Ed25519 keyring in the signing_keys volume
# (REPORT_SIGNING_KEY_DIR=/app/data/signing-keys). Production uses REPORT_SIGNING_PROVIDER=vault (Phase 24).

# Phase 21 — public reporting wizard (/report) and case status (/status). Wrong PINs lock a case
# for COMPLAINTS_PIN_LOCKOUT after COMPLAINTS_MAX_PIN_ATTEMPTS failures (shared via Redis, Phase 24).
COMPLAINTS_MAX_PIN_ATTEMPTS=5
COMPLAINTS_PIN_LOCKOUT=PT15M
# Optional: POST JSON here whenever a case changes stage (blank = log only; no email/SMS is sent).
COMPLAINTS_NOTIFY_WEBHOOK_URL=

# Phase 24 — engineering maturity. Commented values are the compose defaults.
# Any profile other than dev refuses to start while the demo secrets above are set (backend and ml-service).
# APP_PROFILE=dev
# Rate limits, PIN lockouts, exposure counters and the SLA lock: redis (shared by all instances) or memory
# STATE_STORE=redis
# REDIS_PASSWORD=
# ML_SERVICE_TIMEOUT=PT60S
# ml-service processes, device and video frames per forward pass (see load/README.md)
# ML_WORKERS=1
# ML_DEVICE=auto
# VIDEO_BATCH_SIZE=8
# JSON logs with request IDs; BACKEND_LOG_FORMAT= (empty) / ML_LOG_FORMAT=text for readable logs
# BACKEND_LOG_FORMAT=ecs
# ML_LOG_FORMAT=json
# Report signing: file (dev keyring) or vault (HashiCorp Vault Transit; the key never leaves Vault)
# REPORT_SIGNING_PROVIDER=file
# REPORT_SIGNING_ALLOW_FILE_KEYS=false
# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_TRANSIT_KEY=fmd-report-signing
# RFC 3161 timestamp authority for signed reports, and a path (in the container) to a PEM bundle of TSA certs to trust
# REPORT_TSA_URL=
# REPORT_TSA_TRUSTED_CERTS=
# GRAFANA_ADMIN_PASSWORD=admin

# Phase 25: one-click demo story at /tour (dev profile only). DEMO_PUBLIC=true is for a hosted demo
# (docker-compose.demo.yml): anyone may reset, logins are shown, only the bundled synthetic samples upload.
# DEMO_ENABLED=true
# DEMO_PUBLIC=false
# DEMO_RESET_INTERVAL=PT6H
# DEMO_RESET_COOLDOWN=PT2M
# DEMO_UPLOADS_PER_MINUTE=60
# DEMO_JURISDICTION=IN
# Hosted demo only: public host name (feed.<DEMO_DOMAIN> serves the mock feed). See docs/PUBLIC_DEMO.md
# DEMO_DOMAIN=demo.example.org

# Operator details shown in /terms and /privacy (frontend build-time; blank = demo placeholders).
# Rebuild the frontend image after changing them. Have both documents reviewed by counsel before launch.
VITE_LEGAL_OPERATOR=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_GRIEVANCE_OFFICER=
VITE_LEGAL_GOVERNING_LAW=
