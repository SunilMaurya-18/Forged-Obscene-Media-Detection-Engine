# Production settings for docker-compose.prod.yml. Copy to .env on the server and fill in every
# REQUIRED value. Generate secrets with `openssl rand -hex 32`. Never commit the filled-in file.
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build --wait

# --- Site -------------------------------------------------------------------------------------
# REQUIRED: public host name; its DNS A record must point at this server before the first start
DOMAIN=

# --- Secrets (REQUIRED) -----------------------------------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 32+ characters. Signs the provenance manifest embedded in labelled files. Changing it later makes files
# labelled earlier fail verification.
PROVENANCE_SIGNING_KEY=
# 32+ characters. Partner account IDs are stored only as HMAC(key, account); changing it later
# unlinks every existing pseudonym.
INVESTIGATION_PSEUDONYM_KEY=

# --- Accounts (REQUIRED) ----------------------------------------------------------------------
# Passwords need 12+ characters and must differ from the username.
MODERATOR_USERNAME=
MODERATOR_PASSWORD=
# More accounts, comma-separated "username:password:ROLE:team". ROLE is MODERATOR, SENIOR_MODERATOR
# or INVESTIGATOR (team = agency). Second review and appeals must be decided by a different person,
# and legal requests need a senior moderator, so add at least one more moderator and one senior.
# Example: priya:<password>:SENIOR_MODERATOR:core,arjun:<password>:MODERATOR:core
MODERATOR_EXTRA_ACCOUNTS=

# --- Legal pages (REQUIRED operator and email; shown in /terms and /privacy) -------------------
# Built into the frontend: rebuild after changing. Have both documents reviewed by a lawyer.
VITE_LEGAL_OPERATOR=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_GRIEVANCE_OFFICER=
VITE_LEGAL_GOVERNING_LAW=
# YYYY-MM-DD
VITE_LEGAL_EFFECTIVE_DATE=

# --- Report signing ---------------------------------------------------------------------------
# file: the Ed25519 key is generated on first start and kept in the signing_keys volume (back it up).
# vault: HashiCorp Vault Transit, the key never leaves Vault (set VAULT_ADDR and VAULT_TOKEN).
REPORT_SIGNING_PROVIDER=file
REPORT_SIGNING_ALLOW_FILE_KEYS=true
# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_TRANSIT_KEY=fmd-report-signing
# Optional RFC 3161 timestamp authority for signed reports
# REPORT_TSA_URL=

# --- Detection --------------------------------------------------------------------------------
# heuristic (fast, no download) or transformers (a real classifier; needs `transformers` in the
# ml-service image and about 1 GB more RAM)
NSFW_BACKEND=heuristic
# Score thresholds: at or above *_REVIEW goes to a moderator, at or above *_AUTO_FLAG is removed
DECISION_FORGERY_REVIEW=0.50
DECISION_EXPLICIT_REVIEW=0.50
DECISION_FORGERY_AUTO_FLAG=0.85
DECISION_EXPLICIT_AUTO_FLAG=0.85

# --- Compliance -------------------------------------------------------------------------------
# Jurisdiction applied when a complaint doesn't name one, and the local zone printed on reports
COMPLIANCE_DEFAULT_JURISDICTION=IN
REPORT_LOCAL_ZONE=Asia/Kolkata
COMPLIANCE_SLA_USER_COMPLAINT=PT2H
COMPLIANCE_SLA_GOVERNMENT_ORDER=PT3H
COMPLIANCE_SLA_AT_RISK=PT30M
# Optional: JSON POSTs for SLA escalations and case status changes (blank = log only)
COMPLIANCE_ESCALATION_WEBHOOK_URL=
COMPLAINTS_NOTIFY_WEBHOOK_URL=

# --- Partner API ------------------------------------------------------------------------------
# Requests per minute per key for each plan. Issue keys from the API access page.
API_RATE_LIMIT_FREE=10
API_RATE_LIMIT_PRO=60
API_RATE_LIMIT_ENTERPRISE=600
